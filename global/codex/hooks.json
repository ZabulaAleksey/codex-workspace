{
  "description": "AI Dev Team lifecycle hooks: load compact project state and block a small set of destructive commands.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/session_context.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\session_context.py\"",
            "statusMessage": "Loading project AI status",
            "additionalContextLimit": 3000,
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/session_context.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\session_context.py\"",
            "statusMessage": "Loading project context for subagent",
            "additionalContextLimit": 2000,
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/guard_destructive.py",
            "commandWindows": "py -3 \"%USERPROFILE%\\.codex\\hooks\\guard_destructive.py\"",
            "statusMessage": "Checking destructive command policy",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
