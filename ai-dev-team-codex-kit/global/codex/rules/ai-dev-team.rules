# Rules are an additional guardrail for commands that request execution outside the sandbox.

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force-push is not delegated to Codex. Use a normal push or perform the force-push manually after review.",
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Force-push is not delegated to Codex.",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset may destroy uncommitted work. Prefer a reversible restore or explicit manual action.",
)

prefix_rule(
    pattern = ["git", "clean", "-fd"],
    decision = "forbidden",
    justification = "git clean can irreversibly remove untracked files.",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "External GitHub write: confirm before pushing.",
)

prefix_rule(
    pattern = ["gh", "pr", "create"],
    decision = "prompt",
    justification = "Creating a pull request is an external write.",
)

prefix_rule(
    pattern = ["npm", "publish"],
    decision = "prompt",
    justification = "Publishing a package is an external write.",
)

prefix_rule(
    pattern = ["docker", "system", "prune"],
    decision = "forbidden",
    justification = "System-wide prune can remove resources belonging to other projects.",
)
